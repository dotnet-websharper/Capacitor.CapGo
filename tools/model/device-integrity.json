  "methods": [
    {
      "name": "getCapabilities",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DeviceIntegrityCapabilities"
      },
      "promise": true,
      "comment": "Returns the native integrity capabilities available on the current platform."
    },
    {
      "name": "getWidevineFingerprint",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "WidevineFingerprintOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "WidevineFingerprintResult"
      },
      "promise": true,
      "comment": "Returns an Android Widevine-derived fingerprint.\n\nThe default `fingerprint` is SHA-256 over the Widevine device unique ID and a salt.\nIf `hashSalt` is not provided, Android uses the app package name as the salt.\n\nThe raw Widevine ID is sensitive and is only returned as base64 when `includeRawId` is true."
    },
    {
      "name": "prepareAttestation",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "PrepareAttestationOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "PrepareAttestationResult"
      },
      "promise": true,
      "comment": "Prepares native attestation state and returns the key/provider handle.\n\niOS: creates an App Attest key.\nAndroid: prepares a Play Integrity Standard token provider."
    },
    {
      "name": "createAttestation",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CreateAttestationOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AttestationTokenResult"
      },
      "promise": true,
      "comment": "Creates a registration attestation token bound to a backend-issued challenge."
    },
    {
      "name": "createAssertion",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CreateAssertionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AttestationTokenResult"
      },
      "promise": true,
      "comment": "Creates a request assertion token bound to a request payload."
    },
    {
      "name": "getDeviceCheckToken",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DeviceCheckTokenResult"
      },
      "promise": true,
      "comment": "Creates an iOS DeviceCheck token for server-side fraud-state lookups."
    }
  ],
