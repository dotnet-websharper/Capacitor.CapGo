    {
      "name": "CreateAssertionOptions",
      "kind": "config",
      "required": [
        {
          "name": "keyId",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "payload",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "cloudProjectNumber",
          "type": {
            "k": "string"
          }
        }
