            "k": "string"
          }
        },
        {
          "name": "format",
          "type": {
            "k": "ref",
            "name": "PrepareAttestationResultFormat"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "PrepareAttestationResultFormat",
      "kind": "enumStrings",
      "cases": [
        "apple-app-attest",
        "google-play-integrity-standard"
      ]
    },
