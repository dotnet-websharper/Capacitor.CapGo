          "name": "widevineIdBase64",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "securityLevel",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "vendor",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "version",
