          }
        },
        {
          "name": "widevine",
          "type": {
            "k": "ref",
            "name": "WidevineCapabilities"
          }
        },
        {
          "name": "appAttest",
          "type": {
            "k": "ref",
            "name": "SupportStatus"
          }
        },
        {
          "name": "deviceCheck",
          "type": {
            "k": "ref",
            "name": "SupportStatus"
          }
        },
        {
          "name": "playIntegrity",
          "type": {
            "k": "ref",
            "name": "SupportStatus"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "DeviceIntegrityCapabilitiesPlatform",
      "kind": "enumStrings",
      "cases": [
        "android",
        "ios",
        "web"
      ]
    },
    {
      "name": "PrepareAttestationOptions",
      "kind": "config",
