            "k": "bool"
          }
        },
        {
          "name": "hashSalt",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "WidevineFingerprintResult",
      "kind": "config",
      "required": [
        {
          "name": "platform",
          "type": {
