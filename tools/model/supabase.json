        {
          "name": "expiresAt",
          "type": {
            "k": "float"
          }
        }
      ]
    },
    {
      "name": "SetSessionOptions",
      "kind": "config",
      "required": [
        {
          "name": "accessToken",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "refreshToken",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
