  "events": [
    {
      "name": "authStateChange",
      "listener": {
        "k": "ref",
        "name": "AuthStateChange"
      }
    }
  ],
  "unsupported": [
    {
      "method": "select",
      "reason": "generic method cannot be flattened"
    },
    {
      "method": "insert",
      "reason": "generic method cannot be flattened"
    },
    {
      "method": "update",
      "reason": "generic method cannot be flattened"
    },
    {
      "method": "delete",
      "reason": "generic method cannot be flattened"
    }
  ],
  "coreRefs": [],
  "externalTypes": []
}
