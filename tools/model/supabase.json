          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "SignUpOptions",
      "kind": "config",
      "required": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "data",
