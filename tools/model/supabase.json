      "name": "initialize",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SupabaseConfig"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Initialize the Supabase client with your project credentials.\nMust be called before any other methods."
    },
    {
      "name": "signInWithPassword",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignInWithPasswordOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Sign in with email and password."
    },
    {
      "name": "signUp",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignUpOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Sign up a new user with email and password."
    },
    {
      "name": "signInAnonymously",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Sign in anonymously.\nCreates a temporary guest session without requiring credentials."
    },
    {
      "name": "signInWithOAuth",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignInWithOAuthOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sign in with an OAuth provider.\nOpens the provider's authentication page."
    },
    {
      "name": "signInWithOtp",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignInWithOtpOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sign in with OTP (One-Time Password) sent via email or SMS."
    },
    {
      "name": "verifyOtp",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "VerifyOtpOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Verify an OTP token."
    },
    {
      "name": "signOut",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sign out the current user."
    },
    {
      "name": "getSession",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetSessionResult"
      },
      "promise": true,
      "comment": "Get the current session if one exists.\nReturns the session with JWT access token."
    },
    {
      "name": "refreshSession",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetSessionResult"
      },
      "promise": true,
      "comment": "Refresh the current session and get new tokens."
    },
    {
      "name": "getUser",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetUserResult"
      },
      "promise": true,
      "comment": "Get the currently authenticated user."
    },
    {
      "name": "setSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "GetSessionResult"
      },
      "promise": true,
      "comment": "Set the session manually with access and refresh tokens.\nUseful for restoring a session or integrating with external auth."
    },
    {
      "name": "removeAllListeners",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove all listeners for auth state changes."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version."
    }
