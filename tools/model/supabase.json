        {
          "name": "scopes",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "SignInWithOAuthOptionsProvider",
      "kind": "enumStrings",
      "cases": [
        "apple",
        "azure",
        "bitbucket",
        "discord",
        "facebook",
        "figma",
        "github",
        "gitlab",
        "google",
        "kakao",
        "keycloak",
        "linkedin",
        "linkedin_oidc",
        "notion",
        "slack",
        "slack_oidc",
        "spotify",
        "twitch",
        "twitter",
        "workos",
        "zoom"
      ]
    },
