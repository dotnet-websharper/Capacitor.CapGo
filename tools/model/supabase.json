          }
        },
        {
          "name": "session",
          "type": {
            "k": "ref",
            "name": "Session"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "AuthStateChangeEvent",
      "kind": "enumStrings",
      "cases": [
        "INITIAL_SESSION",
        "SIGNED_IN",
        "SIGNED_OUT",
        "TOKEN_REFRESHED",
        "USER_UPDATED",
        "PASSWORD_RECOVERY"
      ]
