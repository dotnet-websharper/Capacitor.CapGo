      "optional": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "phone",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "lastSignInAt",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "userMetadata",
          "type": {
            "k": "map",
            "of": {
              "k": "obj"
            }
          }
