      ],
      "returns": {
        "k": "ref",
        "name": "StoredData"
      },
      "promise": true,
      "comment": "Gets a biometric-protected value for the given key.\nThe value must have been stored with `accessControl` set to BIOMETRY_CURRENT_SET or BIOMETRY_ANY."
    },
