  "methods": [
    {
      "name": "getInfo",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DeviceInfoSnapshot"
      },
      "promise": true,
      "comment": "Read one CPU, memory, GPU, storage, thermal, and onboard sensor snapshot."
    },
    {
      "name": "startMonitoring",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "MonitoringOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "StartMonitoringResult"
      },
      "promise": true,
      "comment": "Start periodic device snapshots.\n\nListen to `deviceInfoUpdate` to receive samples. Calling this while monitoring\nis already active restarts monitoring with the new options."
    },
    {
      "name": "stopMonitoring",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "StopMonitoringResult"
      },
      "promise": true,
