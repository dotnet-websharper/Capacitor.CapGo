{
  "namespace": "AutofillSavePassword",
  "family": "Auth",
  "package": "@capgo/capacitor-autofill-save-password",
  "version": "8.2.6",
  "license": "MPL-2.0",
  "export": "SavePassword",
  "types": [
    {
      "name": "GetPluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "Options",
      "kind": "config",
      "required": [
        {
          "name": "username",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "url",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "ReadPasswordResult",
      "kind": "config",
      "required": [
        {
          "name": "username",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    }
  ],
  "methods": [
    {
      "name": "promptDialog",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "Options"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Save a password to the keychain.\n\nOn iOS 26.2 and later, resolving means the system accepted the request —\nnot that the credential was stored. The save prompt belongs to the system\nand the user's choice is not reported back, so do not treat a resolved\npromise as confirmation. Below 26.2, and on Android, dismissing the prompt\nrejects."
    },
    {
      "name": "readPassword",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "ReadPasswordResult"
      },
      "promise": true,
      "comment": "Read a password from the keychain. Requires the developer to setup associated domain for the app for iOS."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version."
    }
  ],
  "events": [],
  "unsupported": [],
  "coreRefs": [],
  "externalTypes": []
}
