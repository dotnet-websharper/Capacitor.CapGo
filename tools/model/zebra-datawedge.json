    {
      "name": "getScanSessionCapabilities",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetScanSessionCapabilitiesResult"
      },
      "promise": true,
      "comment": "Read native session API capabilities without sending a DataWedge command.\nCurrently returns version 2 with customProfileNames, renewableLease and sessionAssociationDetails\nset to true. The version and capability flags identify supported behavior and allow applications\nto detect future session API changes. Future versions and capabilities will be documented."
    },
    {
      "name": "beginScanSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "BeginScanSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ScanSession"
      },
      "promise": true,
      "comment": "Validate an existing app-owned profile and acquire an opt-in exclusive native session.\nAutomatically renews the native liveness lease from JS until end, native closure, page hiding,\nrenewal failure or the absolute timeout. Application completion/cancellation must still call end.\nReturns the validated appList snapshot; it is not a cache or permission for later profile mutations.\nNative begin failures leave no allocated session. Background begin rejects SESSION_INACTIVE;\nanother reserved session rejects SESSION_BUSY; an unassociated profile rejects SESSION_UNASSOCIATED.\nIf JS cancellation races successful allocation, rejection includes sessionId and cleanupConfirmed for cleanup retry.\nHeartbeat handling requires no framework lifecycle integration. autoRenew: false is for experts.\nThe caller configures INTENT output/decoders and verifies scanner readiness. No profile is created.\nProfiles enrolled in sessions require the matching sessionId on subsequent setConfig calls during\nthis process. Use session APIs to trigger or end scanning and avoid changing the active session's\nprofile through other low-level APIs."
    },
    {
      "name": "renewScanSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RenewScanSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ScanSessionState"
      },
      "promise": true,
      "comment": "Advanced manual renewal; normally called internally. Cannot revive an expired/closing session."
    },
    {
      "name": "getScanSessionState",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RenewScanSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ScanSessionState"
      },
      "promise": true,
      "comment": "Inspect the matching session, including closure reason. Does not renew or confirm cleanup."
    },
    {
      "name": "triggerScanSession",
      "params": [
        {
          "name": "options",
          "type": {
