            "name": "RenewScanSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Verify the active profile, then dispatch START_SCANNING for a foreground session. Scan values arrive via the scan event."
    },
    {
      "name": "endScanSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RenewScanSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "EndScanSessionResult"
      },
      "promise": true,
      "comment": "Cancel owned pending calls, remove the action and await targeted Barcode Input disable.\nResolves only after DataWedge acknowledges cleanup. A failed/unanswered end is retryable and\nblocks new sessions; do not start a camera scanner until confirmed. Concurrent end calls reject\nSESSION_BUSY; repeating a completed end is idempotent. Pause/deadline cleanup is best effort and\nstill requires explicit end acknowledgement. No persistent process-death recovery is enabled."
    },
