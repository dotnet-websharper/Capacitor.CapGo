  "methods": [
    {
      "name": "isAvailable",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "UwbAvailabilityResult"
      },
      "promise": true,
      "comment": "Check whether UWB is supported and currently available on the device."
    },
    {
      "name": "getDiscoveryToken",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DiscoveryTokenResult"
      },
      "promise": true,
      "comment": "Get the local Nearby Interaction discovery token on iOS.\n\nShare the returned token with a peer out-of-band, then call\n`startPeerSession()` with the peer token."
    },
    {
      "name": "startPeerSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StartPeerSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Start a Nearby Interaction peer session on iOS."
    },
    {
      "name": "startControllerSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StartControllerSessionOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AndroidControllerSessionResult"
      },
      "promise": true,
      "comment": "Start an Android UWB controller session and return shareable parameters."
    },
    {
      "name": "startControleeSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StartControleeSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Start an Android UWB controlee session with parameters from the controller."
    },
    {
      "name": "stopSession",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Stop the active UWB ranging session."
    },
    {
      "name": "removeAllListeners",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove all registered listeners for this plugin."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PluginVersionResult"
      },
      "promise": true,
      "comment": "Get the current native plugin version."
    }
