  "events": [
    {
      "name": "rangingUpdate",
      "listener": {
        "k": "ref",
        "name": "RangingUpdateEvent"
      }
    },
    {
      "name": "sessionStateChanged",
      "listener": {
        "k": "ref",
        "name": "SessionStateChangedEvent"
      }
    }
