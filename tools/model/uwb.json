      "optional": [
        {
          "name": "reason",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "SessionStateChangedEventState",
      "kind": "enumStrings",
      "cases": [
        "initialized",
        "running",
        "suspended",
        "resumed",
        "invalidated",
        "stopped",
        "peerDisconnected"
      ]
    },
    {
      "name": "StartControleeSessionOptions",
      "kind": "config",
