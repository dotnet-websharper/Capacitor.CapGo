  "methods": [
    {
      "name": "isAvailable",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "AvailabilityResult"
      },
      "promise": true,
      "comment": "Returns whether the current platform supports the native health SDK."
    },
    {
      "name": "requestAuthorization",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AuthorizationOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthorizationStatus"
      },
      "promise": true,
      "comment": "Requests read/write access to the provided data types.\n\nSet `requestHistoryAccess: true` to additionally request Android's\n`READ_HEALTH_DATA_HISTORY` permission in the same Health Connect permission sheet\n(see {@link AuthorizationOptions.requestHistoryAccess}). The granted/denied status is\nreported back as `historyAccessAuthorized` on the result."
    },
    {
      "name": "checkAuthorization",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AuthorizationOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthorizationStatus"
      },
      "promise": true,
      "comment": "Checks authorization status for the provided data types without prompting the user."
    },
    {
      "name": "readSamples",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "QueryOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ReadSamplesResult"
      },
      "promise": true,
      "comment": "Reads samples for the given data type within the specified time frame."
    },
    {
      "name": "saveSample",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "WriteSampleOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Writes a single sample to the native health store."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version"
    },
    {
      "name": "openHealthConnectSettings",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Opens the Health Connect settings screen (Android only).\nOn iOS, this method does nothing.\n\nUse this to direct users to manage their Health Connect permissions\nor to install Health Connect if not available."
    },
    {
      "name": "showPrivacyPolicy",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Shows the app's privacy policy for Health Connect (Android only).\nOn iOS, this method does nothing.\n\nThis displays the same privacy policy screen that Health Connect shows\nwhen the user taps \"Privacy policy\" in the permissions dialog.\n\nThe privacy policy URL can be configured by adding a string resource\nnamed \"health_connect_privacy_policy_url\" in your app's strings.xml,\nor by placing an HTML file at www/privacypolicy.html in your assets."
    },
    {
      "name": "queryWorkouts",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "QueryWorkoutsOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "QueryWorkoutsResult"
      },
      "promise": true,
      "comment": "Queries workout sessions from the native health store.\nSupported on iOS (HealthKit) and Android (Health Connect)."
    },
    {
