  "methods": [
    {
      "name": "start",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StartOptions"
          },
          "optional": false
        },
        {
          "name": "callback",
          "type": {
            "k": "func",
            "args": [
              {
                "k": "ref",
                "name": "Location"
              },
              {
                "k": "ref",
                "name": "CallbackError"
              }
            ],
            "ret": {
              "k": "unit"
            }
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "To start listening for changes in the device's location, call this method.\nA Promise is returned to indicate that it finished the call. The callback will be called every time a new location\nis available, or if there was an error when calling this method. Don't rely on promise rejection for this."
    },
    {
      "name": "stop",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Stops location updates."
    },
    {
      "name": "updateHeaders",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "UpdateHeadersOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Replaces HTTP headers used by native POSTs without restarting tracking.\n\nUse this when an access token expires while `url` delivery is active.\nHeaders apply to the running location watcher and to geofence setup when\nthose features have a configured `url`."
    },
    {
      "name": "clearGeofenceQueue",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Drops geofence transitions queued for a native POST and not yet sent.\n\nQueued transitions go out with the `headers` in place when they are sent,\nso call this when the user signs out, or before another account's\ncredentials are given to {@link BackgroundGeolocationPlugin.updateHeaders}\nor {@link BackgroundGeolocationPlugin.setupGeofencing}. The queue is also\nemptied when `setupGeofencing` is given a different `url`. On web there is\nno queue and this resolves at once."
    },
    {
      "name": "openSettings",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Opens the device's location settings page.\nUseful for directing users to enable location services or adjust permissions."
    },
    {
      "name": "setPlannedRoute",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetPlannedRouteOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Plays a sound file when the user deviates from the planned route.\nThis should be used to play a sound (in the background too, only for native)."
    },
    {
      "name": "setupGeofencing",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "GeofenceSetupOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Configures native geofence transition handling.\n\nCall this before adding geofences when you need default entry/exit settings\nor native background POSTs. Android background POSTs require\n`backgroundLocation: true`."
    },
    {
      "name": "addGeofence",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AddGeofenceOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Starts monitoring a circular native geofence."
    },
    {
      "name": "removeGeofence",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RemoveGeofenceOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Stops monitoring one geofence."
    },
    {
      "name": "removeAllGeofences",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Stops monitoring every geofence registered by this plugin."
    },
    {
      "name": "getMonitoredGeofences",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "MonitoredGeofencesResult"
      },
      "promise": true,
      "comment": "Lists the geofence identifiers currently monitored by this plugin."
    },
    {
      "name": "getLocationLog",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "GetLocationLogOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LocationLogResult"
      },
      "promise": true,
      "comment": "Reads the locations kept by {@link StartOptions.locationLog}, whether or\nnot tracking is running. Nothing is kept on the web, so the result is\nempty there."
    },
    {
      "name": "clearLocationLog",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "ClearLocationLogOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Removes entries from the location log, for example once they have been\nread or uploaded."
    },
    {
      "name": "checkPermissions",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "BackgroundGeolocationPermissionStatus"
      },
      "promise": true,
      "comment": "Read current location authorization without prompting or side effects.\n\nOn iOS this maps `CLAuthorizationStatus` so you can distinguish Always from\nWhile Using App. On Android this reports foreground location,\n`ACCESS_BACKGROUND_LOCATION`, and notification permission where relevant."
    },
    {
      "name": "requestPermissions",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RequestBackgroundGeolocationPermissionsOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "BackgroundGeolocationPermissionStatus"
      },
      "promise": true,
      "comment": "Request location-related permissions from the user.\n\nPrefer {@link BackgroundGeolocationPlugin.checkPermissions} for read-only\nstatus in settings screens. Call this only when the user has opted in."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version"
    }
  ],
  "events": [
    {
      "name": "geofenceTransition",
