          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "referrer",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "clickTimestampSeconds",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "installBeginTimestampSeconds",
          "type": {
            "k": "float"
          }
        },
        {
