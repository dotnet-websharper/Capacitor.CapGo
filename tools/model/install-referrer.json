          {
            "k": "string"
          },
          {
            "k": "float"
          },
          {
            "k": "bool"
          }
        ]
      }
    },
    {
      "name": "PluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
