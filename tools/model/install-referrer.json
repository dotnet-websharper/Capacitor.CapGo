      "returns": {
        "k": "ref",
        "name": "GetReferrerResult"
      },
      "promise": true,
      "comment": "Returns native install attribution details.\n\nAndroid reads the Google Play Install Referrer API.\niOS returns an Apple AdServices attribution token and can optionally fetch Apple's attribution payload."
    },
    {
      "name": "GetReferrer",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "GetReferrerOptions"
