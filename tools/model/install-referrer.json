        }
      ],
      "returns": {
        "k": "ref",
        "name": "GetReferrerResult"
      },
      "promise": true,
      "comment": "Backward-compatible alias for plugins inspired by cap-play-install-referrer."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PluginVersionResult"
      },
      "promise": true,
      "comment": "Returns the platform implementation version marker."
    }
