    {
      "name": "ResultCode",
      "kind": "enum",
      "cases": [
        {
          "name": "Success",
          "value": -1
        },
        {
          "name": "Canceled",
          "value": 0
        },
        {
          "name": "FirstUser",
          "value": 1
        }
      ]
    }
