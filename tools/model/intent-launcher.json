      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "GetApplicationIconOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "GetApplicationIconResult"
      },
      "promise": true,
      "comment": "Gets the application icon as a base64-encoded PNG string."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version."
    }
