    {
      "name": "IOSSettingsResult",
      "kind": "config",
      "required": [
        {
          "name": "success",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "OpenApplicationOptions",
      "kind": "config",
      "required": [
        {
          "name": "packageName",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
