  "methods": [
    {
      "name": "startActivityAsync",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "IntentLauncherParams"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "IntentLauncherResult"
      },
      "promise": true,
      "comment": "Starts an Android activity for the given action."
    },
    {
      "name": "openIOSSettings",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "IOSSettingsParams"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "IOSSettingsResult"
      },
      "promise": true,
      "comment": "Opens iOS settings screen.\n\nNote: The only officially supported option by Apple is `App` which opens your app's settings page.\nOther options may work but are not guaranteed and could break in future iOS versions or cause App Store rejection.\n\nAlso note that the iOS Simulator will sometimes only open the Settings app,\ninstead of the specified option."
    },
    {
      "name": "openApplication",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "OpenApplicationOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Opens an application by its package name."
    },
    {
