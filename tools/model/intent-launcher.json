      "optional": []
    },
    {
      "name": "GetPluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "IntentLauncherParams",
      "kind": "config",
      "required": [
        {
          "name": "action",
          "type": {
            "k": "string"
          }
        }
