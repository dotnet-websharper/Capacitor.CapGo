      ],
      "returns": {
        "k": "ref",
        "name": "PasskeyRegistrationCredential"
      },
      "promise": true,
      "comment": "Register a passkey from a JSON-safe WebAuthn request.\n\nThis method is useful when your backend already returns the\n`PublicKeyCredentialCreationOptionsJSON` form."
    },
    {
      "name": "getCredential",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "GetCredentialOptions"
