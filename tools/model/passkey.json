          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "PasskeyAuthenticationCredential"
      },
      "promise": true,
      "comment": "Authenticate with an existing passkey from a JSON-safe WebAuthn request.\n\nThis method is useful when your backend already returns the\n`PublicKeyCredentialRequestOptionsJSON` form."
    },
