  "methods": [
    {
      "name": "shimWebAuthn",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "ShimWebAuthnOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": false,
      "comment": "Install a browser-style WebAuthn shim on top of the native plugin.\n\nThe shim patches `navigator.credentials.create/get` for `publicKey`\nrequests and returns browser-like credential objects.\n\nUse this when you want to override the auto-loaded config manually."
    },
    {
      "name": "getConfiguration",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PasskeyRuntimeConfiguration"
      },
      "promise": true,
      "comment": "Load plugin configuration from the host Capacitor app.\n\nThis reads `plugins.CapacitorPasskey` from `capacitor.config.*`."
    },
    {
      "name": "autoShimWebAuthn",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "ShimWebAuthnOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "PasskeyRuntimeConfiguration"
      },
      "promise": true,
      "comment": "Install the browser-style shim using host app configuration.\n\nThis is the easiest way to keep existing browser WebAuthn code working:\nconfigure the plugin in `capacitor.config.*`, then call this once during\napp bootstrap."
    },
    {
      "name": "createCredential",
