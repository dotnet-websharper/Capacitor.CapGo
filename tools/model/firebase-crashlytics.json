{
  "namespace": "FirebaseCrashlytics",
  "family": "Analytics",
  "package": "@capgo/capacitor-firebase-crashlytics",
  "version": "8.3.1",
  "export": "FirebaseCrashlytics",
  "types": [
    {
      "name": "CrashOptions",
      "kind": "config",
      "required": [
        {
          "name": "message",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "CustomKeyAndValue",
      "kind": "config",
      "required": [
        {
          "name": "key",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "value",
          "type": {
            "k": "union",
            "of": [
              {
                "k": "string"
              },
              {
                "k": "float"
              },
              {
                "k": "bool"
              }
            ]
          }
        },
        {
          "name": "type",
          "type": {
            "k": "ref",
            "name": "CustomKeyAndValueType"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "CustomKeyAndValueType",
      "kind": "enumStrings",
      "cases": [
        "string",
        "boolean",
        "long",
        "double",
        "int",
        "float"
      ]
    },
    {
      "name": "DidCrashOnPreviousExecutionResult",
      "kind": "config",
      "required": [
        {
          "name": "crashed",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "GetPluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "IsEnabledResult",
      "kind": "config",
      "required": [
        {
          "name": "enabled",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "LogOptions",
      "kind": "config",
      "required": [
        {
          "name": "message",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "RecordExceptionOptions",
      "kind": "config",
      "required": [
        {
          "name": "message",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "code",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "domain",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "keysAndValues",
          "type": {
            "k": "array",
            "of": {
              "k": "ref",
              "name": "CustomKeyAndValue"
            }
          }
        },
        {
          "name": "stacktrace",
          "type": {
            "k": "array",
            "of": {
              "k": "ref",
              "name": "StackFrame"
            }
          }
        }
      ]
    },
    {
      "name": "SetEnabledOptions",
      "kind": "config",
      "required": [
        {
          "name": "enabled",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "SetUserIdOptions",
      "kind": "config",
      "required": [
        {
          "name": "userId",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "StackFrame",
      "kind": "config",
      "required": [],
      "optional": [
        {
          "name": "lineNumber",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "fileName",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "functionName",
          "type": {
            "k": "string"
          }
        }
      ]
    }
  ],
  "methods": [
    {
      "name": "crash",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CrashOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Forces a crash to test the implementation.\n\nOnly available for Android and iOS."
    },
    {
      "name": "setCustomKey",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CustomKeyAndValue"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sets a custom key and value that is associated with subsequent fatal and non-fatal reports.\n\nOnly available for Android and iOS."
    },
    {
      "name": "setUserId",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetUserIdOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sets a user ID (identifier) that is associated with subsequent fatal and non-fatal reports.\n\nOnly available for Android and iOS."
    },
    {
      "name": "log",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "LogOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Adds a custom log message that is sent with your crash data to give yourself more context for the events leading up to a crash.\n\nOnly available for Android and iOS."
    },
    {
      "name": "setEnabled",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetEnabledOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Enables/disables automatic data collection.\nThe value does not apply until the next run of the app.\n\nOnly available for Android and iOS."
    },
    {
      "name": "isEnabled",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "IsEnabledResult"
      },
      "promise": true,
      "comment": "Returns whether or not automatic data collection is enabled.\n\nOnly available for iOS."
    },
    {
      "name": "didCrashOnPreviousExecution",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DidCrashOnPreviousExecutionResult"
      },
      "promise": true,
      "comment": "Returns whether the app crashed during the previous execution.\n\nOnly available for Android and iOS."
    },
    {
      "name": "sendUnsentReports",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Uploads any unsent reports to Crashlytics at next startup.\n\nWhen automatic data collection is enabled, Crashlytics automatically uploads reports at startup.\n\nOnly available for Android and iOS."
    },
    {
      "name": "deleteUnsentReports",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Deletes any unsent reports on the device.\n\nOnly available for Android and iOS."
    },
    {
      "name": "recordException",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RecordExceptionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Records a non-fatal report to send to Crashlytics.\n\nOnly available for Android and iOS."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the version of this plugin."
    }
  ],
  "events": [],
  "unsupported": [],
  "coreRefs": [],
  "externalTypes": []
}
