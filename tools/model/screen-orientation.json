  "methods": [
    {
      "name": "orientation",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "ScreenOrientationResult"
      },
      "promise": true,
      "comment": "Get the current screen orientation.\n\nReturns the current orientation of the device screen."
    },
    {
      "name": "lock",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "OrientationLockOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Lock the screen orientation to a specific type.\n\nLocks the screen to the specified orientation.\nOn iOS, if bypassOrientationLock is true, it will also start\ntracking physical device orientation using motion sensors.\n\nNote: The UI will still respect the user's orientation lock setting.\nMotion tracking allows you to detect how the device is physically held\neven when the UI doesn't rotate.\n\nOn iOS 15 there is no public API to force a rotation, so the lock restricts\nthe allowed orientations and the UI rotates into them when the device\norientation allows it. On iOS 16 and later the rotation is requested immediately."
    },
    {
      "name": "unlock",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Unlock the screen orientation.\n\nAllows the screen to rotate freely based on device position.\nAlso stops any motion-based orientation tracking if it was enabled."
    },
    {
      "name": "startOrientationTracking",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StartOrientationTrackingOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Start tracking device orientation using motion sensors.\n\nThis method is useful when you want to track the device's physical\norientation independently from the screen orientation lock.\nIt uses Core Motion on iOS to detect orientation changes."
    },
    {
      "name": "stopOrientationTracking",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Stop tracking device orientation using motion sensors.\n\nStops the motion-based orientation tracking if it was started."
    },
    {
      "name": "isOrientationLocked",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "OrientationLockStatusResult"
      },
      "promise": true,
      "comment": "Check if device orientation lock is currently enabled.\n\nThis method compares the physical device orientation (from motion sensors)\nwith the UI orientation. If they differ, orientation lock is enabled.\n\nNote: This requires motion tracking to be active via\nstartOrientationTracking() or lock() with bypassOrientationLock: true.\nWorks on both iOS (Core Motion) and Android (Accelerometer)."
    },
    {
      "name": "isDeviceFoldable",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DeviceFoldableResult"
      },
      "promise": true,
      "comment": "Listen for screen orientation changes.\n\nRegisters a listener that will be called whenever the screen orientation changes.\nIf motion-based tracking is enabled, this will also fire for orientation changes\ndetected by motion sensors even when orientation lock is enabled. Whether this device folds, and whether it can stand half-open like a laptop.\n\nOn web, both flags are `false` when the browser lacks fold APIs or the current reading shows\nno fold (`devicePosture.type` is `continuous` with a single viewport segment). `foldable`\nbecomes `true` when posture is `folded` or the viewport splits into two segments.\nOn web, `supportsTabletop` reflects the current reading (for example, `false` in a book\npose) rather than permanent device capability.\n\nOn Android, both flags are `false` on phones that do not fold. On iOS, both are `false`\nexcept on iPhone Duo (iOS 27.1 or later)."
    },
    {
      "name": "getFoldState",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "FoldState"
      },
      "promise": true,
      "comment": "Read the current fold.\n\nResolves to a flat state when the device has no fold. On web, uses\n`navigator.devicePosture` and `window.viewport.segments` when the browser provides them."
    },
    {
      "name": "getHingeAngle",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "HingeAngleResult"
      },
      "promise": true,
      "comment": "Read the hinge angle in degrees.\n\n`0` is closed and `180` is flat. `angle` is `null` without a hinge sensor."
    },
    {
      "name": "getReservedRegions",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetReservedRegionsResult"
      },
      "promise": true,
      "comment": "Read the fold and anything covering the screen.\n\niPhone Duo reports the fold, the vertical status bar area, and the under-display camera.\nResolves to an empty list on Android, web, and iOS before 27.1."
    },
    {
      "name": "getBarPlacement",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "BarPlacement"
      },
      "promise": true,
      "comment": "Read where iPhone Duo puts native tab bars and toolbars.\n\n`verticalBarEdge` is `null` when bars stay horizontal, and always on Android and web."
    },
    {
      "name": "setVerticalBarBehavior",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetVerticalBarBehaviorOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "SetVerticalBarBehaviorResult"
      },
      "promise": true,
      "comment": "Choose whether iPhone Duo may move this app's bars to the side.\n\nResolves to `{ applied: false }` unless the app's bridge view controller opts in.\nAndroid and web always resolve to `{ applied: false }`."
    },
    {
      "name": "getSizeClass",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "SizeClass"
      },
      "promise": true,
      "comment": "Read the window size classes."
    },
    {
      "name": "removeAllListeners",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove all listeners for this plugin.\n\nRemoves all registered event listeners."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native plugin version.\n\nReturns the current version of the native plugin implementation."
    }
  ],
