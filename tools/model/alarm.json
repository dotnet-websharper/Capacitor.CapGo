{
  "namespace": "Alarm",
  "family": "Device",
  "package": "@capgo/capacitor-alarm",
  "version": "8.1.16",
  "export": "CapgoAlarm",
  "types": [
    {
      "name": "AlarmInfo",
      "kind": "config",
      "required": [
        {
          "name": "id",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "hour",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "minute",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "label",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "enabled",
          "type": {
            "k": "bool"
          }
        }
      ]
    },
    {
      "name": "CancelAlarmOptions",
      "kind": "config",
      "required": [
        {
          "name": "id",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "GetAlarmsResult",
      "kind": "config",
      "required": [
        {
          "name": "alarms",
          "type": {
            "k": "array",
            "of": {
              "k": "ref",
              "name": "AlarmInfo"
            }
          }
        }
      ],
      "optional": [
        {
          "name": "message",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "GetPluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
