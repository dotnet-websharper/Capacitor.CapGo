      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AutoStateOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Stores a process-local JSON state slice and emits the same `stateChanged` event."
