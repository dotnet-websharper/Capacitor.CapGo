    {
      "name": "check",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CheckWebViewOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "WebViewVersionStatus"
      },
      "promise": true,
      "comment": "Runs a version check and returns the latest known status."
    },
    {
      "name": "startMonitoring",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StartMonitoringOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "MonitoringStateResult"
      },
      "promise": true,
      "comment": "Enables background monitoring (typically on app resume)."
    },
    {
      "name": "stopMonitoring",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "MonitoringStateResult"
      },
      "promise": true,
      "comment": "Disables monitoring."
    },
    {
      "name": "getLastStatus",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "LastStatusResult"
      },
      "promise": true,
      "comment": "Returns the last resolved status, or `null` if no check was run yet."
    },
    {
      "name": "showUpdatePrompt",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "ShowUpdatePromptOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ShowUpdatePromptResult"
      },
      "promise": true,
      "comment": "Shows a native prompt asking the user to update the WebView."
    },
    {
      "name": "openUpdatePage",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "OpenUpdatePageOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "OpenUpdatePageResult"
      },
      "promise": true,
      "comment": "Opens the configured update page directly."
    }
