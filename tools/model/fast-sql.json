          }
        }
      ]
    },
    {
      "name": "ConnectResult",
      "kind": "config",
      "required": [
        {
          "name": "port",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "token",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "database",
          "type": {
            "k": "string"
          }
        }
