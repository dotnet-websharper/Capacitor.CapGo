          "type": {
            "k": "float"
          }
        }
      ]
    },
    {
      "name": "GetServerInfoResult",
      "kind": "config",
      "required": [
        {
          "name": "port",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "token",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "persistent",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "binaryProtocolVersion",
          "type": {
            "k": "float"
          }
        }
      ]
    },
    {
      "name": "IsolationLevel",
