        "READ UNCOMMITTED",
        "READ COMMITTED",
        "REPEATABLE READ",
        "SERIALIZABLE"
      ]
    },
    {
      "name": "SQLConnectionOptions",
      "kind": "config",
      "required": [
        {
          "name": "database",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "transport",
          "type": {
            "k": "ref",
            "name": "SQLConnectionOptionsTransport"
          }
        },
        {
          "name": "encrypted",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "encryptionKey",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "readOnly",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "walMode",
          "type": {
            "k": "bool"
          }
