          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ConnectResult"
      },
      "promise": true,
      "comment": "Initialize the database connection and start the HTTP server."
    },
    {
      "name": "disconnect",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "DisconnectOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Close database connection and stop the HTTP server."
    },
    {
      "name": "getServerInfo",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "DisconnectOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "GetServerInfoResult"
      },
      "promise": true,
      "comment": "Get the HTTP server port and token for direct communication."
    },
    {
      "name": "execute",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "ExecuteOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "SQLResult"
      },
      "promise": true,
      "comment": "Execute a SQL query via Capacitor bridge (for simple queries).\nFor better performance with large datasets, use the HTTP protocol directly via SQLConnection class."
    },
    {
      "name": "beginTransaction",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "BeginTransactionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Begin a database transaction."
    },
    {
      "name": "commitTransaction",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "DisconnectOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Commit the current transaction."
    },
    {
      "name": "rollbackTransaction",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "DisconnectOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Rollback the current transaction."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version."
    },
    {
      "name": "configureWeb",
      "params": [
        {
          "name": "config",
          "type": {
            "k": "ref",
            "name": "WebConfig"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Configure web-specific options for the official SQLite Wasm module.\n\nCall this **before** the first `connect()` call if you need to disable OPFS\nor supply a custom Worker. This method is a no-op on iOS and Android."
    }
  ],
  "events": [],
  "unsupported": [],
  "coreRefs": [],
