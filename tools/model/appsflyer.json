          "name": "cuid",
          "type": {
            "k": "ref",
            "name": "AFCuid"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Setting your own customer ID enables you to cross-reference your own unique ID with AppsFlyer's unique ID and other devices' IDs.\nThis ID is available in raw-data reports and in the Postback APIs for cross-referencing with your internal IDs."
    },
    {
      "name": "setCurrencyCode",
      "params": [
        {
          "name": "currencyCode",
          "type": {
            "k": "ref",
            "name": "AFCurrency"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sets the currency for in-app purchases. The currency code should be a 3 character ISO 4217 code"
    },
    {
      "name": "updateServerUninstallToken",
      "params": [
        {
          "name": "token",
          "type": {
            "k": "ref",
            "name": "AFUninstall"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "(Android) Allows to pass GCM/FCM Tokens that where collected by third party plugins to the AppsFlyer server. Can be used for Uninstall log.\n(iOS) Allows to pass APN Tokens that where collected by third party plugins to the AppsFlyer server. Can be used for log Uninstall."
    },
    {
      "name": "setAppInviteOneLink",
      "params": [
        {
          "name": "id",
          "type": {
            "k": "ref",
            "name": "AFOnelinkID"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Set the OneLink ID that should be used for attributing user-Invite. The link that is generated for the user invite will use this OneLink as the base link."
    },
    {
      "name": "setOneLinkCustomDomain",
      "params": [
        {
          "name": "domains",
          "type": {
            "k": "ref",
            "name": "AFOnelinkDomain"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "In order for AppsFlyer SDK to successfully resolve hidden (decoded in shortlink ID) attribution parameters, any domain that is configured as a branded domain in the AppsFlyer Dashboard should be provided to this method."
    },
    {
      "name": "appendParametersToDeepLinkingURL",
      "params": [
        {
          "name": "data",
          "type": {
            "k": "ref",
            "name": "AFAppendToDeepLink"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Enables app owners using App Links for deep linking (without OneLink) to attribute sessions initiated via a domain associated with their app. Call this method before calling start.\nYou must provide the following parameters in the parameters Map:\npid\nis_retargeting must be set to true"
    },
    {
      "name": "setResolveDeepLinkURLs",
      "params": [
        {
          "name": "urls",
          "type": {
            "k": "ref",
            "name": "AFUrls"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Advertisers can wrap an AppsFlyer OneLink within another Universal Link. This Universal Link will invoke the app but any deep linking data will not propagate to AppsFlyer.\nsetResolveDeepLinkURLs enables you to configure the SDK to resolve the wrapped OneLink URLs, so that deep linking can occur correctly."
    },
    {
      "name": "addPushNotificationDeepLinkPath",
      "params": [
        {
          "name": "path",
          "type": {
            "k": "ref",
            "name": "AFPath"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Configures how the SDK extracts deep link values from push notification payloads."
    },
