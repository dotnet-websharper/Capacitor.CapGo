          "type": {
            "k": "string"
          }
        },
        {
          "name": "qos",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "retained",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "PublishResult",
      "kind": "config",
      "required": [
        {
          "name": "topic",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "payload",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "qos",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "retained",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "messageId",
          "type": {
            "k": "obj"
          }
        }
      ],
      "optional": []
