          "type": {
            "k": "bool"
          }
        },
        {
          "name": "connectionTimeout",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "keepAliveInterval",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "setAutomaticReconnect",
          "type": {
            "k": "bool"
