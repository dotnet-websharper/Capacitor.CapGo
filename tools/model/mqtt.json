        {
          "name": "message",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "PublishOptions",
      "kind": "config",
      "required": [
        {
          "name": "topic",
          "type": {
            "k": "string"
          }
