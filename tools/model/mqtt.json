    },
    {
      "name": "onConnectComplete",
      "listener": {
        "k": "ref",
        "name": "OnConnectCompleteEvent"
      }
    },
    {
      "name": "onMessageArrived",
      "listener": {
        "k": "ref",
        "name": "OnMessageArrivedEvent"
      }
