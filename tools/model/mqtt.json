          "type": {
            "k": "string"
          }
        },
        {
          "name": "port",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "clientId",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "username",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        },
