{
  "namespace": "Neon",
  "family": "Analytics",
  "package": "@capgo/capacitor-neon",
  "version": "8.1.2",
  "license": "MPL-2.0",
  "export": "CapacitorNeon",
  "types": [
    {
      "name": "AnonymousToken",
      "kind": "config",
      "required": [
        {
          "name": "token",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "expiresAt",
          "type": {
            "k": "float"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "AuthResult",
      "kind": "config",
      "required": [
        {
          "name": "session",
          "type": {
            "k": "ref",
            "name": "Session"
          }
        },
        {
          "name": "user",
          "type": {
            "k": "ref",
            "name": "User"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "AuthStateChange",
      "kind": "config",
      "required": [
        {
          "name": "event",
          "type": {
            "k": "ref",
            "name": "AuthStateChangeEvent"
          }
        },
        {
          "name": "session",
          "type": {
            "k": "ref",
            "name": "Session"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "AuthStateChangeEvent",
      "kind": "enumStrings",
      "cases": [
        "INITIAL_SESSION",
        "SIGNED_IN",
        "SIGNED_OUT",
        "TOKEN_REFRESHED"
      ]
    },
    {
      "name": "GetPluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "GetSessionResult",
      "kind": "config",
      "required": [
        {
          "name": "session",
          "type": {
            "k": "ref",
            "name": "Session"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "GetUserResult",
      "kind": "config",
      "required": [
        {
          "name": "user",
          "type": {
            "k": "ref",
            "name": "User"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "NeonConfig",
      "kind": "config",
      "required": [
        {
          "name": "authUrl",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "dataApiUrl",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "origin",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "Session",
      "kind": "config",
      "required": [
        {
          "name": "accessToken",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "refreshToken",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "tokenType",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "expiresIn",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "user",
          "type": {
            "k": "ref",
            "name": "User"
          }
        }
      ],
      "optional": [
        {
          "name": "expiresAt",
          "type": {
            "k": "float"
          }
        },
        {
          "name": "sessionExpiresAt",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "SetSessionOptions",
      "kind": "config",
      "required": [
        {
          "name": "refreshToken",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "accessToken",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "SignInWithOAuthOptions",
      "kind": "config",
      "required": [
        {
          "name": "provider",
          "type": {
            "k": "ref",
            "name": "SignInWithOAuthOptionsProvider"
          }
        },
        {
          "name": "redirectTo",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "scopes",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "SignInWithOAuthOptionsProvider",
      "kind": "enumStrings",
      "cases": [
        "google",
        "github",
        "vercel"
      ]
    },
    {
      "name": "SignInWithOtpOptions",
      "kind": "config",
      "required": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "SignInWithPasswordOptions",
      "kind": "config",
      "required": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "SignUpOptions",
      "kind": "config",
      "required": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "password",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "name",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "image",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "User",
      "kind": "config",
      "required": [
        {
          "name": "id",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "image",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "emailVerified",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "phone",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "role",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "VerifyOtpOptions",
      "kind": "config",
      "required": [
        {
          "name": "email",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "token",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "type",
          "type": {
            "k": "ref",
            "name": "VerifyOtpOptionsType"
          }
        }
      ]
    },
    {
      "name": "VerifyOtpOptionsType",
      "kind": "enumStrings",
      "cases": [
        "email",
        "signup"
      ]
    }
  ],
  "methods": [
    {
      "name": "initialize",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "NeonConfig"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Initialize the Neon client with your branch URLs.\nMust be called before any other methods. Restores a stored session and\nemits `INITIAL_SESSION`."
    },
    {
      "name": "signInWithPassword",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignInWithPasswordOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Sign in with email and password."
    },
    {
      "name": "signUp",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignUpOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Sign up a new user with email and password."
    },
    {
      "name": "getAnonymousToken",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "AnonymousToken"
      },
      "promise": true,
      "comment": "Get an anonymous Data API token.\nNeon Auth has no anonymous user accounts. This token lets signed-out users\nquery the Data API as the `anonymous` Postgres role, so RLS policies for\nthat role apply. Database methods use it automatically when no one is\nsigned in."
    },
    {
      "name": "signInWithOAuth",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignInWithOAuthOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sign in with an OAuth provider.\nOpens the provider's authentication page in the system browser. When your\napp reopens at `redirectTo`, the plugin completes sign-in and emits\n`SIGNED_IN`."
    },
    {
      "name": "signInWithOtp",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SignInWithOtpOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sign in with OTP (One-Time Password) sent via email."
    },
    {
      "name": "verifyOtp",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "VerifyOtpOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AuthResult"
      },
      "promise": true,
      "comment": "Verify an OTP token."
    },
    {
      "name": "signOut",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Sign out the current user."
    },
    {
      "name": "getSession",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetSessionResult"
      },
      "promise": true,
      "comment": "Get the current session if one exists.\nReturns the session with JWT access token, minting a new one when the\ncached token is close to expiry."
    },
    {
      "name": "refreshSession",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetSessionResult"
      },
      "promise": true,
      "comment": "Refresh the current session and get a new access token."
    },
    {
      "name": "getUser",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetUserResult"
      },
      "promise": true,
      "comment": "Get the currently authenticated user."
    },
    {
      "name": "setSession",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetSessionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "GetSessionResult"
      },
      "promise": true,
      "comment": "Set the session manually from a refresh token.\nUseful for restoring a session or integrating with external auth."
    },
    {
      "name": "removeAllListeners",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove all listeners for auth state changes."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version."
    }
  ],
  "events": [
    {
      "name": "authStateChange",
      "listener": {
        "k": "ref",
        "name": "AuthStateChange"
      }
    }
  ],
  "unsupported": [
    {
      "method": "select",
      "reason": "generic method cannot be flattened"
    },
    {
      "method": "insert",
      "reason": "generic method cannot be flattened"
    },
    {
      "method": "update",
      "reason": "generic method cannot be flattened"
    },
    {
      "method": "delete",
      "reason": "generic method cannot be flattened"
    }
  ],
  "coreRefs": [],
  "externalTypes": []
}
