      "required": [
        {
          "name": "isLoggedIn",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "hasValidToken",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": [
        {
          "name": "identity",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "LoginOptions",
