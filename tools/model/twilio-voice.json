          "type": {
            "k": "string"
          }
        },
        {
          "name": "to",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "reason",
          "type": {
            "k": "ref",
            "name": "OutgoingCallFailedEventReason"
          }
        }
      ],
      "optional": [
        {
          "name": "displayName",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "OutgoingCallFailedEventReason",
      "kind": "enumStrings",
      "cases": [
        "missing_access_token",
        "connection_failed",
        "no_call_details",
        "microphone_permission_denied",
        "invalid_contact",
        "callkit_request_failed",
        "unsupported_intent"
      ]
    },
    {
      "name": "OutgoingCallInitiatedEvent",
      "kind": "config",
      "required": [
        {
          "name": "callSid",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "to",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "source",
          "type": {
            "k": "ref",
            "name": "OutgoingCallInitiatedEventSource"
          }
        }
      ],
      "optional": [
        {
          "name": "displayName",
          "type": {
            "k": "string"
          }
        }
