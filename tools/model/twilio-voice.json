            "k": "string"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "LoginResult",
      "kind": "config",
      "required": [
        {
          "name": "success",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "MakeCallOptions",
      "kind": "config",
      "required": [
        {
          "name": "to",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "displayName",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "callerId",
          "type": {
            "k": "string"
          }
        }
      ]
    },
    {
      "name": "MakeCallResult",
      "kind": "config",
      "required": [
        {
          "name": "success",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": [
        {
          "name": "callSid",
