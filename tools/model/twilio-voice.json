  "methods": [
    {
      "name": "login",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "LoginOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "Authenticate the user with Twilio Voice using an access token.\n\nThe access token should be generated on your backend server using your Twilio credentials.\nThis token is required to make and receive calls through Twilio Voice."
    },
    {
      "name": "logout",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "Log out the current user and unregister from Twilio Voice.\n\nThis will disconnect any active calls and stop the device from receiving\nnew incoming call notifications."
    },
    {
      "name": "isLoggedIn",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "IsLoggedInResult"
      },
      "promise": true,
      "comment": "Check if the user is currently logged in and has a valid access token."
    },
    {
      "name": "makeCall",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "MakeCallOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "MakeCallResult"
      },
      "promise": true,
      "comment": "Initiate an outgoing call to a phone number or client.\n\nThe user must be logged in before making a call. The call will be routed\nthrough your Twilio backend configuration."
    },
    {
      "name": "acceptCall",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AcceptCallOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "Accept an incoming call.\n\nThis should be called in response to a 'callInviteReceived' event."
    },
    {
      "name": "rejectCall",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AcceptCallOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "Reject an incoming call.\n\nThis should be called in response to a 'callInviteReceived' event.\nThe caller will hear a busy signal or be directed to voicemail."
    },
    {
      "name": "endCall",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "EndCallOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "End an active call.\n\nIf callSid is not provided, this will end the currently active call."
    },
    {
      "name": "muteCall",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "MuteCallOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "Mute or unmute the microphone during an active call.\n\nWhen muted, the other party will not hear audio from your microphone."
    },
    {
      "name": "setSpeaker",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetSpeakerOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "LoginResult"
      },
      "promise": true,
      "comment": "Enable or disable speakerphone mode.\n\nWhen enabled, audio will be routed through the device's speaker instead of the earpiece."
    },
    {
      "name": "getCallStatus",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetCallStatusResult"
      },
      "promise": true,
      "comment": "Get the current status of the active call.\n\nThis provides real-time information about the call state, mute status,\nhold status, and call identifiers."
    },
    {
      "name": "checkMicrophonePermission",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "CheckMicrophonePermissionResult"
      },
      "promise": true,
      "comment": "Check if microphone permission has been granted.\n\nThis does not request permission, only checks the current permission status."
    },
    {
      "name": "requestMicrophonePermission",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "CheckMicrophonePermissionResult"
      },
      "promise": true,
      "comment": "Request microphone permission from the user.\n\nOn iOS and Android, this will show the system permission dialog if permission\nhas not been granted yet. If permission was previously denied, the user may need\nto grant it in system settings."
    },
    {
      "name": "removeAllListeners",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove all registered event listeners.\n\nThis is useful for cleanup when your component unmounts or when you want to\nreset all event handling."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPluginVersionResult"
      },
      "promise": true,
      "comment": "Get the native Capacitor plugin version"
    }
  ],
