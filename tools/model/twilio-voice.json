          "type": {
            "k": "bool"
          }
        },
        {
          "name": "isMuted",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "pendingInvites",
          "type": {
            "k": "array",
            "of": {
              "k": "ref",
              "name": "CallInvite"
            }
          }
        },
        {
          "name": "activeCallsCount",
          "type": {
            "k": "float"
          }
        }
