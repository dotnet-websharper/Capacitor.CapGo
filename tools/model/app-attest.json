          "name": "options",
          "type": {
            "k": "ref",
            "name": "PrepareOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "PrepareResult"
      },
      "promise": true,
      "comment": "Legacy alias for `prepare()`."
    },
