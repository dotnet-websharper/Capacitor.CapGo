  "methods": [
    {
      "name": "isSupported",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "IsSupportedResult"
      },
      "promise": true,
      "comment": "Checks whether native attestation is available on this device."
    },
    {
      "name": "getCapabilities",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "AppAttestCapabilities"
      },
      "promise": true,
      "comment": "Returns attestation and optional fraud-signal capabilities available on the current platform.\n\nWidevine is Android-only and optional. Apps that do not call Widevine methods do not need any\nWidevine-specific setup."
    },
    {
      "name": "prepare",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "PrepareOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "PrepareResult"
      },
      "promise": true,
      "comment": "Prepares attestation state and returns the key handle used for later calls.\n\niOS: generates a real App Attest key identifier.\nAndroid: prepares a Play Integrity Standard token provider handle."
    },
    {
      "name": "createAttestation",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CreateAttestationOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "CreateAttestationResult"
      },
      "promise": true,
      "comment": "Creates a registration attestation token bound to a backend-issued challenge.\n\niOS: returns App Attest `attestationObject`.\nAndroid: returns Play Integrity Standard token."
    },
    {
      "name": "createAssertion",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "CreateAssertionOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "CreateAssertionResult"
      },
      "promise": true,
      "comment": "Creates a request assertion token bound to a request payload.\n\niOS: returns App Attest assertion.\nAndroid: returns Play Integrity Standard token."
    },
    {
      "name": "getWidevineFingerprint",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "WidevineFingerprintOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "WidevineFingerprintResult"
      },
      "promise": true,
      "comment": "Returns an optional Android Widevine-derived fingerprint.\n\nThis method is Android-only and is not part of the normal attestation flow. Call it only when\nyour app needs a DRM-backed fraud signal and your privacy policy covers that use.\n\nThe default `fingerprint` is SHA-256 over the Widevine device unique ID and a salt.\nIf `hashSalt` is not provided, Android uses the app package name as the salt.\n\nThe raw Widevine ID is sensitive and is only returned as base64 when `includeRawId` is true."
    },
    {
      "name": "getDeviceCheckToken",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "DeviceCheckTokenResult"
      },
      "promise": true,
      "comment": "Creates an iOS DeviceCheck token for server-side fraud-state lookups."
    },
    {
      "name": "storeKeyId",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "StoreKeyIdOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "OperationResult"
      },
      "promise": true,
      "comment": "Stores/prepares a key identifier for reuse.\n\niOS: persists in UserDefaults.\nAndroid: prepares a native Play Integrity provider for this key id in memory (process lifetime)."
    },
    {
      "name": "getStoredKeyId",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetStoredKeyIdResult"
      },
      "promise": true,
      "comment": "Returns the currently stored/prepared key identifier.\n\nAndroid value is only available while the process is alive."
    },
    {
      "name": "clearStoredKeyId",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "OperationResult"
      },
      "promise": true,
      "comment": "Clears stored/prepared key identifiers."
    },
