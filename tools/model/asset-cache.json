          "type": {
            "k": "string"
          }
        },
        {
          "name": "revalidate",
          "type": {
            "k": "ref",
            "name": "AssetCacheRevalidateOptions"
          }
        }
      ]
    },
    {
      "name": "AssetCacheKeyOptions",
      "kind": "config",
      "required": [],
