          "type": {
            "k": "string"
          }
        },
        {
          "name": "path",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "remoteUrl",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "local",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "fromCache",
          "type": {
            "k": "bool"
          }
        },
        {
          "name": "status",
          "type": {
            "k": "ref",
            "name": "ResolvedAssetSourceStatus"
          }
