          }
        },
        {
          "name": "cdnUrl",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "revalidate",
          "type": {
            "k": "ref",
            "name": "AssetCacheRevalidateOptions"
          }
        }
      ]
    },
