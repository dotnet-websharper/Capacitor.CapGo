  "methods": [
    {
      "name": "configure",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AssetCacheConfigOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": false,
      "comment": "Set defaults for future `src(...)`, `resolve(...)`, and `bind(...)` calls."
    },
    {
      "name": "resolve",
      "params": [
        {
          "name": "path",
          "type": {
            "k": "union",
            "of": [
              {
                "k": "string"
              },
              {
                "k": "ref",
                "name": "ResolveAssetSourceOptions"
              }
            ]
          },
          "optional": false
        },
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AssetCacheSourceOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "ResolvedAssetSource"
      },
      "promise": true,
      "comment": "Resolve a CDN path or remote URL into a local display-ready source URL."
    },
    {
      "name": "src",
      "params": [
        {
          "name": "path",
          "type": {
            "k": "union",
            "of": [
              {
                "k": "string"
              },
              {
                "k": "ref",
                "name": "ResolveAssetSourceOptions"
              }
            ]
          },
          "optional": false
        },
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AssetCacheSourceOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "string"
      },
      "promise": true,
      "comment": "Resolve a CDN path or remote URL into a local string ready for `img.src` or `video.src`."
    },
    {
      "name": "bind",
      "params": [
        {
          "name": "element",
          "type": {
            "k": "union",
            "of": [
              {
                "k": "ext",
                "name": "HTMLImageElement"
              },
              {
                "k": "ext",
                "name": "HTMLVideoElement"
              }
            ]
          },
          "optional": false
        },
        {
          "name": "path",
          "type": {
            "k": "union",
            "of": [
              {
                "k": "string"
              },
              {
                "k": "ref",
                "name": "ResolveAssetSourceOptions"
              }
            ]
          },
          "optional": false
        },
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AssetCacheBindOptions"
          },
          "optional": true
        }
      ],
      "returns": {
        "k": "ref",
        "name": "AssetCacheBinding"
      },
      "promise": false,
      "comment": "Bind an image or video element to a local asset and update it when ready."
    },
    {
      "name": "get",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "GetAssetOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "CachedAsset"
      },
      "promise": true,
      "comment": "Resolve an asset URL into a local persistent file."
    },
    {
      "name": "remove",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "AssetCacheKeyOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "RemoveAssetResult"
      },
      "promise": true,
      "comment": "Remove one cached asset by key or URL."
    },
    {
      "name": "clear",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "ClearCacheResult"
      },
      "promise": true,
      "comment": "Remove every cached asset managed by this plugin."
    },
    {
      "name": "list",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "AssetCacheListResult"
      },
      "promise": true,
      "comment": "List cached assets that still exist on disk."
    },
    {
      "name": "getCacheSize",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "AssetCacheSizeResult"
      },
      "promise": true,
      "comment": "Return total cached asset bytes."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PluginVersionResult"
      },
      "promise": true,
      "comment": "Returns the platform implementation version marker."
    }
  ],
  "events": [],
  "unsupported": [],
  "coreRefs": [],
  "externalTypes": [
    "HTMLImageElement",
    "HTMLVideoElement"
  ]
}
