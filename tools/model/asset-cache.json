        {
          "name": "maxAgeSeconds",
          "type": {
            "k": "float"
          }
        }
      ]
    },
    {
      "name": "AssetCacheRevalidateOptionsStrategy",
      "kind": "enumStrings",
      "cases": [
        "never",
        "ttl",
        "always",
        "etag",
        "last-modified"
