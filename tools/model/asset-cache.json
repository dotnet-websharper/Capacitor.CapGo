          "name": "url",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "key",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "headers",
          "type": {
            "k": "ref",
            "name": "ResolveAssetSourceOptionsHeadersMap"
          }
        },
        {
          "name": "revalidate",
          "type": {
            "k": "ref",
            "name": "AssetCacheRevalidateOptions"
          }
        }
      ]
    },
    {
      "name": "PluginVersionResult",
      "kind": "config",
      "required": [
        {
          "name": "version",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": []
