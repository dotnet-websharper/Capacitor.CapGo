    {
      "name": "RemoveAssetResult",
      "kind": "config",
      "required": [
        {
          "name": "removed",
          "type": {
            "k": "bool"
          }
        }
      ],
      "optional": []
    },
    {
      "name": "ResolveAssetSourceOptions",
      "kind": "config",
      "required": [
        {
          "name": "path",
          "type": {
            "k": "string"
          }
        }
      ],
      "optional": [
        {
          "name": "key",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "headers",
          "type": {
            "k": "ref",
            "name": "ResolveAssetSourceOptionsHeadersMap"
          }
        },
        {
          "name": "cdnUrl",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "revalidate",
          "type": {
            "k": "ref",
