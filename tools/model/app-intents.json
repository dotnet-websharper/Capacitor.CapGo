      "name": "performAppleSchemaTemplate",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "PerformAppleSchemaTemplateOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "PerformAppleSchemaTemplateResult"
      },
      "promise": true,
      "comment": "Queue a JavaScript handler for an alpha Apple schema template.\n\nThis does not call private Mail or system schema APIs. It only enqueues an\ninvocation (for example `appleSchemaMailCreateDraft`) for your app code to handle."
    },
    {
      "name": "removeAllListeners",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove all listeners for this plugin."
