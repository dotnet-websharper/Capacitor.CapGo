  "methods": [
    {
      "name": "getPendingInvocations",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "GetPendingInvocationsResult"
      },
      "promise": true,
      "comment": "Return invocations queued before JavaScript was ready."
    },
    {
      "name": "removePendingInvocation",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RemovePendingInvocationOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove one pending invocation after your handler processes it."
    },
    {
      "name": "setEntityCatalog",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetEntityCatalogOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Persist an entity catalog for a given type string.\n\nPowers Siri and Shortcuts entity parameters without new Swift per row."
    },
    {
      "name": "setHomeScreenShortcutItems",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "SetHomeScreenShortcutItemsOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Replace Home Screen quick actions (UIApplicationShortcutItems)."
    },
    {
      "name": "indexSpotlightEntities",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "IndexSpotlightEntitiesOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Index Spotlight items for your app domain.\n\nUses `CSSearchableItem` on iOS 16 and later. On iOS 18 and later also donates\n`IndexedEntity` values through `indexAppEntities` and `associateAppEntity`."
    },
    {
      "name": "removeSpotlightEntities",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RemoveSpotlightEntitiesOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Remove Spotlight items by id."
    },
