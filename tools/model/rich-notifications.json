  "methods": [
    {
      "name": "checkPermission",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PermissionResult"
      },
      "promise": true,
      "comment": "Check the current local notification permission status without prompting."
    },
    {
      "name": "requestPermission",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PermissionResult"
      },
      "promise": true,
      "comment": "Request local notification permission from the user.\n\nOn Android 13+, this maps to `POST_NOTIFICATIONS`. On iOS, uses `UNUserNotificationCenter`."
    },
    {
      "name": "createChannel",
      "params": [
        {
          "name": "channel",
          "type": {
            "k": "ref",
            "name": "NotificationChannel"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Create an Android notification channel.\n\nResolves as a no-op on iOS and web."
    },
    {
      "name": "createChannelGroup",
      "params": [
        {
          "name": "group",
          "type": {
            "k": "ref",
            "name": "NotificationChannelGroup"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Create an Android notification channel group.\n\nResolves as a no-op on iOS and web."
    },
    {
      "name": "deleteChannel",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "NotificationIdOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Delete an Android notification channel by id.\n\nResolves as a no-op on iOS and web."
    },
    {
      "name": "display",
      "params": [
        {
          "name": "notification",
          "type": {
            "k": "ref",
            "name": "RichNotification"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "NotificationIdResult"
      },
      "promise": true,
      "comment": "Display a local notification immediately.\n\nReturns the notification id (generated when omitted in the payload)."
    },
    {
      "name": "schedule",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "ScheduleOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "ref",
        "name": "NotificationIdResult"
      },
      "promise": true,
      "comment": "Schedule a local notification for later.\n\nOn Android, exact timing may require `SCHEDULE_EXACT_ALARM` in the host app.\nOn web, scheduling uses `setTimeout` and only works while the page stays open."
    },
    {
      "name": "cancel",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "NotificationIdOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Cancel a pending or displayed notification by id."
    },
    {
      "name": "cancelAll",
      "params": [],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Cancel every pending and displayed local notification managed by this plugin."
    },
    {
      "name": "getDisplayed",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "NotificationListResult"
      },
      "promise": true,
      "comment": "List notifications currently shown in the notification shade or Notification Center."
    },
    {
      "name": "getPending",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "NotificationListResult"
      },
      "promise": true,
      "comment": "List notifications that are scheduled but not yet shown."
    },
    {
      "name": "getInitialNotification",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "InitialNotificationResult"
      },
      "promise": true,
      "comment": "Return the notification that opened the app, if any.\n\nCall early on startup to handle cold-start taps."
    },
    {
      "name": "setBadge",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "BadgeOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Set the app icon badge count (iOS)."
    },
    {
      "name": "registerActions",
      "params": [
        {
          "name": "options",
          "type": {
            "k": "ref",
            "name": "RegisterActionsOptions"
          },
          "optional": false
        }
      ],
      "returns": {
        "k": "unit"
      },
      "promise": true,
      "comment": "Register a reusable action category (iOS `UNNotificationCategory`, Android action set).\n\nReference the same id in `categoryId` when displaying notifications."
    },
    {
      "name": "getPluginVersion",
      "params": [],
      "returns": {
        "k": "ref",
        "name": "PluginVersionResult"
      },
      "promise": true,
      "comment": "Returns the platform implementation version marker (`native` or `web`)."
    }
  ],
  "events": [
    {
      "name": "press",
      "listener": {
        "k": "ref",
        "name": "PressEvent"
      }
    },
    {
      "name": "dismiss",
      "listener": {
        "k": "ref",
        "name": "DismissEvent"
      }
    }
  ],
  "unsupported": [],
  "coreRefs": [],
  "externalTypes": []
}
