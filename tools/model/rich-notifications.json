          "type": {
            "k": "array",
            "of": {
              "k": "string"
            }
          }
        },
        {
          "name": "channelId",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "groupId",
          "type": {
            "k": "string"
          }
        },
        {
          "name": "categoryId",
          "type": {
            "k": "string"
          }
        },
