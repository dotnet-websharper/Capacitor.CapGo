<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Product>WebSharper.Capacitor.CapGo.UI</Product>
    <Title>https://github.com/dotnet-websharper/capacitor.capgo/</Title>
    <Company>IntelliFactory</Company>
    <Copyright>(c) 2023 IntelliFactory</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <NpmDependencies>
			<NpmPackage Name="@capgo/capacitor-android-inline-install" Version="&gt;= 8.0.21 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-android-kiosk" Version="&gt;= 8.3.5 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-date-picker" Version="&gt;= 8.1.16 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-inappbrowser" Version="&gt;= 8.27.9 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-launch-navigator" Version="&gt;= 8.1.9 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-live-activities" Version="&gt;= 1.3.3 &lt; 2.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-native-loader" Version="&gt;= 8.1.14 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-native-navigation" Version="&gt;= 8.16.3 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-pretty-toast" Version="&gt;= 8.1.31 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-printer" Version="&gt;= 8.1.11 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-share-target" Version="&gt;= 8.0.68 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-textinteraction" Version="&gt;= 8.1.11 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-webview-crash" Version="&gt;= 8.1.15 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-webview-guardian" Version="&gt;= 8.1.7 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-webview-version-checker" Version="&gt;= 8.2.21 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-widget-kit" Version="&gt;= 8.2.2 &lt; 9.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CapGoGeneratorCommon\CapGoGeneratorCommon.fsproj" />
    <!-- The binding surface is generated from these models; without them MSBuild
         would happily reuse a stale WebSharper metadata cache. -->
    <CustomAdditionalCompileInputs Include="..\tools\model\*.json" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
