<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Product>WebSharper.Capacitor.CapGo.AI</Product>
    <Title>https://github.com/dotnet-websharper/capacitor.capgo/</Title>
    <Company>IntelliFactory</Company>
    <Copyright>(c) 2023 IntelliFactory</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <NpmDependencies>
			<NpmPackage Name="@capgo/capacitor-llm" Version="&gt;= 8.2.3 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-speech-recognition" Version="&gt;= 8.5.0 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-speech-synthesis" Version="&gt;= 8.0.29 &lt; 9.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CapGoGeneratorCommon\CapGoGeneratorCommon.fsproj" />
    <!-- The binding surface is generated from these models; without them MSBuild
         would happily reuse a stale WebSharper metadata cache. -->
    <CustomAdditionalCompileInputs Include="..\tools\model\*.json" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
