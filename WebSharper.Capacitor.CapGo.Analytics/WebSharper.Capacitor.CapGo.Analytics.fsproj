<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Product>WebSharper.Capacitor.CapGo.Analytics</Product>
    <Title>https://github.com/dotnet-websharper/capacitor.capgo/</Title>
    <Company>IntelliFactory</Company>
    <Copyright>(c) 2023 IntelliFactory</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <NpmDependencies>
			<NpmPackage Name="@capgo/capacitor-appinsights" Version="&gt;= 8.0.65 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-appsflyer" Version="&gt;= 8.1.21 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-contentsquare" Version="&gt;= 8.1.19 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-disqo" Version="&gt;= 8.1.3 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-facebook-analytics" Version="&gt;= 8.1.22 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-analytics" Version="&gt;= 8.0.2 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-app" Version="&gt;= 7.4.2 &lt; 8.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-app-check" Version="&gt;= 7.4.2 &lt; 8.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-authentication" Version="&gt;= 8.0.2 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-crashlytics" Version="&gt;= 8.3.1 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-firestore" Version="&gt;= 8.3.1 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-functions" Version="&gt;= 7.4.2 &lt; 8.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-performance" Version="&gt;= 7.4.2 &lt; 8.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-remote-config" Version="&gt;= 8.3.1 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-firebase-storage" Version="&gt;= 8.3.1 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-gtm" Version="&gt;= 8.0.48 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-install-referrer" Version="&gt;= 8.1.17 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-neon" Version="&gt;= 8.1.2 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-rudderstack" Version="&gt;= 8.1.19 &lt; 9.0.0" ResolutionStrategy="Max" />
			<NpmPackage Name="@capgo/capacitor-supabase" Version="&gt;= 8.2.10 &lt; 9.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CapGoGeneratorCommon\CapGoGeneratorCommon.fsproj" />
    <!-- The binding surface is generated from these models; without them MSBuild
         would happily reuse a stale WebSharper metadata cache. -->
    <CustomAdditionalCompileInputs Include="..\tools\model\*.json" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
